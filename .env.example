# ============================================================
# MarketLens — Environment Variables
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local to git.
# ============================================================

# ---- AI Provider (choose one) --------------------------------
# Option A: Anthropic Claude (recommended)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Option B: OpenAI (uncomment and set AI_PROVIDER below)
# OPENAI_API_KEY=your_openai_api_key_here

# Which AI provider to use: "anthropic" | "openai"
# Defaults to "anthropic" if not set.
AI_PROVIDER=anthropic

# ---- Mock Mode -----------------------------------------------
# Set to "true" to use hardcoded mock data instead of calling AI.
# Useful for development and demos without an API key.
NEXT_PUBLIC_MOCK_MODE=false

# ---- Supabase ------------------------------------------------
# Get these from your Supabase project → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# The service role key is used server-side only (API routes).
# Keep this secret — it bypasses Row Level Security.
# Also required by npm run signals:update to upsert trend signals.
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# ---- App Config ----------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ---- Signal Collector ----------------------------------------
# Optional local dependency: install Python pytrends to collect Google Trends.
# If pytrends or Google Trends fails, npm run signals:update writes safe fallback seed data.
