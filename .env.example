# ============================================================
# MarketLens — Environment Variables
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local to git.
# ============================================================

# ---- AI Generation -------------------------------------------
# Used by /api/generate-report for Deep Analysis.
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# Legacy/unused:
# ANTHROPIC_API_KEY is no longer used by MarketLens.

# ---- Mock Mode -----------------------------------------------
# Set to "true" to use hardcoded mock data instead of calling AI.
# Useful for development and demos without an API key.
NEXT_PUBLIC_MOCK_MODE=false

# ---- Supabase ------------------------------------------------
# Get these from your Supabase project → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# The service role key is used server-side only (API routes).
# Keep this secret — it bypasses Row Level Security.
# Also required by npm run signals:update to upsert trend signals.
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# ---- App Config ----------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ---- Signal Collector ----------------------------------------
# Optional local dependency: install Python pytrends to collect Google Trends.
# If pytrends or Google Trends fails, npm run signals:update writes safe fallback seed data.
REDDIT_COLLECT_ENABLED=true
REDDIT_USER_AGENT=MarketLensBetaSignalCollector/0.3 (contact: you@example.com)
REDDIT_REQUEST_DELAY_MS=650

# Optional Etsy Open API key for real listing counts and price samples.
# Without this, Etsy fields are labeled fallback_estimate and capped in scoring.
ETSY_API_KEY=your_etsy_api_key_here
ETSY_COLLECT_ENABLED=true
